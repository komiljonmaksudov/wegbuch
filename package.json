{
	"name": "wegbuch",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"valibot": "1.5.0"
	},
	"imports": {
		"#lib/assets/*": "./src/lib/assets/*",
		"#lib/live.svelte": "./src/lib/live.svelte.ts",
		"#lib/*.svelte": "./src/lib/*.svelte",
		"#lib/*": "./src/lib/*.ts",
		"#core/*": "./src/core/*.ts"
	}
}
